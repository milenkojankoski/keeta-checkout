# Development wallets for the Keeta test network. Copy to `.env.test` and fill it by
# running `pnpm wallets:create`, which generates the seeds and writes them here.
#
# `.env.test` is gitignored. These wallets only ever hold test-network KTA and test
# tokens, which have no value, but a seed is still a key: never reuse one of these on
# the main network and never commit the file.

# `test` or `main`. The tools refuse to run against `main`.
KEETA_NETWORK=test

# Receives checkout payments in tests. The checkout server itself only ever needs the
# matching public address, never this seed.
KEETA_MERCHANT_SEED=

# Stands in for a customer's wallet: pays the checkout sessions in tests.
KEETA_PAYER_SEED=
