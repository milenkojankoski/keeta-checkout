{
  "name": "keeta-checkout",
  "version": "0.1.0",
  "type": "module",
  "description": "Run a Keeta Checkout server: accept Keeta payments on your website.",
  "keywords": [
    "keeta",
    "payments",
    "checkout",
    "crypto",
    "woocommerce",
    "stablecoin"
  ],
  "homepage": "https://github.com/milenkojankoski/keeta-checkout#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milenkojankoski/keeta-checkout.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/milenkojankoski/keeta-checkout/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "keeta-checkout": "./bin/keeta-checkout.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --external:@keetanetwork/keetanet-client --external:@keetanetwork/anchor --external:express --external:qrcode --outfile=dist/index.mjs"
  },
  "dependencies": {
    "@keetanetwork/anchor": "0.0.105",
    "@keetanetwork/keetanet-client": "0.18.8",
    "express": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@keeta-checkout/server": "workspace:*",
    "@keeta-checkout/refunds": "workspace:*"
  }
}
