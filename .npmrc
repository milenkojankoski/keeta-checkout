# Keep the workspace honest: a dependency must be declared to be importable.
shamefully-hoist=false

# Warn on an engine mismatch instead of failing. Keeta's anchor SDK pins Node 24.14.1
# exactly, while local development on Node 22.13.1 works in practice.
# See docs/decisions/0001-node-24-via-pnpm.md.
engine-strict=false

# Note: `use-node-version` here, and `useNodeVersion` in pnpm-workspace.yaml, are both
# read by pnpm 11.5.2 (`pnpm config get use-node-version` returns the value) but
# neither is applied: `pnpm node --version` and `pnpm run` still use the global Node.
# The pin therefore lives in `.node-version` for CI, and local Node 22 is tolerated.
