# Keep the build context small, and keep the host's files from overwriting the
# container's.
#
# `node_modules` is the one that matters. Without it here, `COPY . .` drops the
# host's dependency tree, built for another platform and full of pnpm symlinks,
# on top of the one the image just installed. pnpm then decides the modules
# directory is inconsistent and tries to purge it, which fails without a TTY and
# takes the build down with it.
node_modules
**/node_modules

# Build output, rebuilt inside the image.
dist
**/dist
*.tsbuildinfo

# Secrets and local state. `.env.test` holds the development wallet seeds.
.env
.env.*
!.env.*.example
*.sqlite
*.sqlite-*
*.db

# History and tooling noise.
.git
.github
.gitignore
.gitattributes
coverage
*.log

# Nothing the server needs at runtime.
docs
plugins
examples
tools
